<?xml version="1.0" encoding="utf-8"?>
<dev.fredol.open_tv.PlayerGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:show_subtitle_button="true"
        app:auto_show="true"
        app:controller_layout_id="@layout/custom_player_control_view" />

    <LinearLayout
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_indicator"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gesture_indicator_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/gesture_indicator_level"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:max="100"
            android:progressTint="@android:color/white"
            android:progressBackgroundTint="#66FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/channel_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_player_indicator"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="480dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seek_indicator_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="160dp"
        android:background="@drawable/bg_player_indicator"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seek_indicator_forward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="160dp"
        android:background="@drawable/bg_player_indicator"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />
</dev.fredol.open_tv.PlayerGestureLayout>
